{
  "name": "@cove/extension-sdk",
  "version": "0.1.0",
  "description": "SDK for building Cove UI extensions. Provides types, hooks, and helpers for the Cove extension system.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/extension-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension-sdk.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.types-dts.json && api-extractor run --local",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@cove/types": "file:../types",
    "@microsoft/api-extractor": "~7.52.0",
    "@tanstack/react-query": "^5.80.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.8.0",
    "vitest": "^4.1.0"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourcove/cove"
  }
}
