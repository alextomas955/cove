{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectUnique"] }],

    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/no-did-update-set-state": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/static-components": "warn",
    "react/use-memo": "warn",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": ["coverage/", "src/generated/"]
}
