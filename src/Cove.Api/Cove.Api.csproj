<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The published single-file executable is "Cove" (Cove.exe / Cove.dll).
         RootNamespace stays Cove.Api so all source namespaces are unaffected. -->
    <AssemblyName>Cove</AssemblyName>
    <RootNamespace>Cove.Api</RootNamespace>
    <!-- Windows executable icon (Cove.exe). Shared Cove logo lives at the repo root. -->
    <ApplicationIcon>..\..\coveicon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Cove.Api serves the Vite-built SPA from wwwroot. In Debug, the ASP.NET Core static
         web assets pipeline spends most of the build scanning those JS chunks for Razor
         collocated modules Cove.Api does not use. Release/publish keeps the SDK pipeline. -->
    <StaticWebAssetsEnabled Condition="'$(Configuration)' == 'Debug'">false</StaticWebAssetsEnabled>
    <PgvectorStagingScript>$(MSBuildProjectDirectory)\..\..\scripts\stage-pgvector-payload.ps1</PgvectorStagingScript>
    <!-- Emit the API contract document during build to the repo-root /contracts directory.
         Forward slashes keep the path portable across build hosts. -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../contracts</OpenApiDocumentsDirectory>
    <!-- The generator only accepts alphanumeric/underscore/dash file names, so the document is emitted
         as cove.json and renamed to the dotted cove.openapi.json below. -->
    <OpenApiGenerateDocumentsOptions>--file-name cove --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
    <PgvectorEmbeddedPayloadDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)pgvector-payload\$(RuntimeIdentifier)</PgvectorEmbeddedPayloadDir>
    <PgvectorPayloadRepository Condition="'$(PgvectorPayloadRepository)' == ''">yourcove/cove</PgvectorPayloadRepository>
    <PgvectorShellExecutable Condition="'$(OS)' == 'Windows_NT'">powershell</PgvectorShellExecutable>
    <PgvectorShellArguments Condition="'$(OS)' == 'Windows_NT'">-NoLogo -NoProfile -ExecutionPolicy Bypass -File</PgvectorShellArguments>
    <PgvectorShellExecutable Condition="'$(OS)' != 'Windows_NT'">pwsh</PgvectorShellExecutable>
    <PgvectorShellArguments Condition="'$(OS)' != 'Windows_NT'">-NoLogo -NoProfile -File</PgvectorShellArguments>
  </PropertyGroup>

  <!-- Publish as a self-contained single-file executable with wwwroot embedded -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- Embed wwwroot as managed resources so the SPA is inside the single-file binary -->
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <!-- For development / dotnet run: copy wwwroot to output directory -->
  <Target Name="CopyWwwrootToBin" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <WwwrootFiles Include="wwwroot\**" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFolder="$(OutputPath)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="EmbedBundledPgvectorPayload"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(SkipPgvectorPayloadStage)' != 'true' and '$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' != '' and Exists('$(PgvectorStagingScript)')">
    <Message Text="Embedding bundled pgvector payload for $(RuntimeIdentifier) from $(PgvectorEmbeddedPayloadDir)" Importance="high" />
    <RemoveDir Directories="$(PgvectorEmbeddedPayloadDir)" Condition="Exists('$(PgvectorEmbeddedPayloadDir)')" />
    <MakeDir Directories="$(PgvectorEmbeddedPayloadDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          Command="&quot;$(PgvectorShellExecutable)&quot; $(PgvectorShellArguments) &quot;$(PgvectorStagingScript)&quot; -Rid &quot;$(RuntimeIdentifier)&quot; -OutputDir &quot;$(PgvectorEmbeddedPayloadDir)&quot; -PayloadRepository &quot;$(PgvectorPayloadRepository)&quot;" />
    <ItemGroup>
      <PgvectorPayloadResource Include="$(PgvectorEmbeddedPayloadDir)\**\*" />
      <EmbeddedResource Include="@(PgvectorPayloadResource)">
        <LogicalName>cove.pgvector/%(PgvectorPayloadResource.RecursiveDir)%(PgvectorPayloadResource.Filename)%(PgvectorPayloadResource.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.5" />
  </ItemGroup>

  <!-- Normalize the emitted contract document name to cove.openapi.json. -->
  <Target Name="RenameOpenApiDocument" AfterTargets="GenerateOpenApiDocuments"
          Condition="Exists('$(OpenApiDocumentsDirectory)/cove.json')">
    <Move SourceFiles="$(OpenApiDocumentsDirectory)/cove.json"
          DestinationFiles="$(OpenApiDocumentsDirectory)/cove.openapi.json"
          OverwriteReadOnlyFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="8.0.0.1" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="8.0.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cove.Core\Cove.Core.csproj" />
    <ProjectReference Include="..\Cove.Data\Cove.Data.csproj" />
    <ProjectReference Include="..\Cove.Plugins\Cove.Plugins.csproj" />
    <ProjectReference Include="..\Cove.Sdk\Cove.Sdk.csproj" />
    <!-- Build-time source generator that emits the host-service DI forwarding (AddCoveHostServices).
         Referenced as an analyzer so the generator assembly is never emitted into this project's
         output and is not propagated to downstream (extension) builds. -->
    <ProjectReference Include="..\..\tools\host-services-gen\host-services-gen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
